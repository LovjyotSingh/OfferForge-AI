NODE_ENV=production
PORT=5000
MONGODB_URI=your_mongodb_atlas_connection_string
# At least 32 random characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_a_long_random_secret
AI_PROVIDER=openrouter
AI_API_KEY=your_ai_provider_api_key
AI_MODEL=openai/gpt-4o-mini
# Max interviews one account may start per 24 hours (protects your AI quota)
DAILY_INTERVIEW_LIMIT=10

# Optional: email (verification + password reset). Free with Gmail or Brevo SMTP.
# Leave blank to switch email features off.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail_address
SMTP_PASS=your_16_char_gmail_app_password
EMAIL_FROM=OfferForge AI <your_gmail_address>
# Public site URL used in email links (defaults to the Vercel production URL)
APP_URL=https://offer-forge-ai.vercel.app
FRONTEND_URL=https://your-frontend-domain.vercel.app
